{
  "expo": {
    "name": "HyperDrop",
    "slug": "hyperdrop",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hyperdrop.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#101312"
      },
      "package": "com.hyperdrop.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font"
    ]
  }
}
